# rolling_retained_earnings — environment configuration
# Copy this to .env and edit before deploying.
# Lines starting with # are comments and are ignored.

# Network
HOST=0.0.0.0     # Use 127.0.0.1 to restrict access to localhost only
PORT=8000

# Uvicorn worker count (production only; ignored in --dev mode)
# A good starting point is (2 × CPU cores) + 1
WORKERS=4

# LLM provider for /api/analyze narrative — "anthropic" or "gemini" (default: anthropic)
LLM_PROVIDER=anthropic

# Anthropic API key (used when LLM_PROVIDER=anthropic)
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Gemini API key (used when LLM_PROVIDER=gemini)
# Get a key at https://aistudio.google.com
GEMINI_API_KEY=
