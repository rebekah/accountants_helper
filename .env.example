# rolling_retained_earnings — environment configuration
# Copy this to .env and edit before deploying.
# Lines starting with # are comments and are ignored.

# Network
HOST=0.0.0.0     # Use 127.0.0.1 to restrict access to localhost only
PORT=8000

# Uvicorn worker count (production only; ignored in --dev mode)
# A good starting point is (2 × CPU cores) + 1
WORKERS=4
